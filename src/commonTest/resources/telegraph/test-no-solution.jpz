<?xml version='1.0' encoding='UTF-8' ?><crossword-compiler-applet xmlns="http://crossword.info/xml/crossword-compiler-applet"><applet-settings cursor-color="#00B100" selected-cells-color="#80FF80"><completion only-if-correct="false">Congratulations! The puzzle is solved correctly.</completion><actions buttons-layout="left"><pencil label="Pencil" /></actions></applet-settings><rectangular-puzzle xmlns="http://crossword.info/xml/rectangular-puzzle"><metadata><title>Example Puzzle for Kotwords</title><creator>Jeff Davidson</creator><copyright>© 2018 Jeff Davidson</copyright><description>Notepad text goes here.</description></metadata><crossword><grid width="5" height="5"><grid-look numbering-scheme="normal" /><cell x="1" y="1" number="1" /><cell x="2" y="1" number="2" /><cell x="3" y="1" number="3" /><cell x="4" y="1" number="4" /><cell x="5" y="1" type="block" /><cell x="1" y="2" number="5" /><cell x="2" y="2" /><cell x="3" y="2" /><cell x="4" y="2" /><cell x="5" y="2" type="block" /><cell x="1" y="3" background-color="#dcdcdc" number="6" /><cell x="2" y="3" /><cell x="3" y="3" /><cell x="4" y="3" /><cell x="5" y="3" background-color="#dcdcdc" number="7" /><cell x="1" y="4" type="block" /><cell x="2" y="4" number="8" /><cell x="3" y="4" /><cell x="4" y="4" /><cell x="5" y="4" /><cell x="1" y="5" type="block" /><cell x="2" y="5" number="9" /><cell x="3" y="5" /><cell x="4" y="5" /><cell x="5" y="5" /></grid><word id="1"><cells x="1" y="1" /><cells x="2" y="1" /><cells x="3" y="1" /><cells x="4" y="1" /></word><word id="2"><cells x="1" y="2" /><cells x="2" y="2" /><cells x="3" y="2" /><cells x="4" y="2" /></word><word id="3"><cells x="1" y="3" /><cells x="2" y="3" /><cells x="3" y="3" /><cells x="4" y="3" /><cells x="5" y="3" /></word><word id="4"><cells x="2" y="4" /><cells x="3" y="4" /><cells x="4" y="4" /><cells x="5" y="4" /></word><word id="5"><cells x="2" y="5" /><cells x="3" y="5" /><cells x="4" y="5" /><cells x="5" y="5" /></word><word id="6"><cells x="1" y="1" /><cells x="1" y="2" /><cells x="1" y="3" /></word><word id="7"><cells x="2" y="1" /><cells x="2" y="2" /><cells x="2" y="3" /><cells x="2" y="4" /><cells x="2" y="5" /></word><word id="8"><cells x="3" y="1" /><cells x="3" y="2" /><cells x="3" y="3" /><cells x="3" y="4" /><cells x="3" y="5" /></word><word id="9"><cells x="4" y="1" /><cells x="4" y="2" /><cells x="4" y="3" /><cells x="4" y="4" /><cells x="4" y="5" /></word><word id="10"><cells x="5" y="3" /><cells x="5" y="4" /><cells x="5" y="5" /></word><clues><title><b>Across</b></title><clue word="1" number="1" format="4"><span>First across clue with </span><i>italic</i><span> &amp; 'quotes'</span></clue><clue word="2" number="5" format="4">Second across clue</clue><clue word="3" number="6" format="5">Third across clue</clue><clue word="4" number="8" format="4">Fourth across clue</clue><clue word="5" number="9" format="4">Fifth across clue</clue></clues><clues><title><b>Down</b></title><clue word="6" number="1" format="3">First down clue</clue><clue word="7" number="2" format="5">Second down clue</clue><clue word="8" number="3" format="5">Third down clue</clue><clue word="9" number="4" format="5">Fourth down clue</clue><clue word="10" number="7" format="3">Fifth down clue</clue></clues></crossword></rectangular-puzzle></crossword-compiler-applet>